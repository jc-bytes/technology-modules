  "offlineRoute": "Use printable-fallback.html and downloaded recordings. Sketch the four event-to-helper connections and retain the app project. Sign-in and cloud sync require internet.",
  "acceptance": {
    "localGuide": "Build/check and 10 tests pass. All 52 routes checked at 1366x768, 1280x720, 1024x720 and 390x844: no horizontal overflow, broken pictures or inaccessible content behind fixed navigation. Real comparison pictures may require vertical scrolling and can be enlarged. Existing response IDs and storage scope retained.",
    "firebaseBackend": "Live authentication, owner access, cross-user denial, vocabulary permissions and refresh rechecked; temporary records removed.",
    "androidDevice": "Optional only, not required for classroom viewer testing",
    "starter": "721 provided blocks load and generate Yail; students add 8 blocks. Actual-block scenario tests passed.",
    "narration": "51 current Kokoro English clips match the revised authored scripts and all decode. Original three word recordings unchanged."
  },
  "teachingReview": "Teacher reported that v1.1 did not explain the start or changes. V1.2 adds verified starter context, editor orientation, explicit purpose/work surface, and before/after diagrams. Needs teacher/student comprehension review; pacing unknown.",
